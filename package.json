{
  "name": "receipt-policy-scanner",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:apk": "cd android && ./gradlew assembleRelease",
    "install:apk": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'test/**/*.{ts,tsx}'",
    "lint:fix": "eslint --fix 'src/**/*.{ts,tsx}' 'test/**/*.{ts,tsx}'",
    "format": "prettier --write 'src/**/*.{ts,tsx}' 'test/**/*.{ts,tsx}' '*.{json,mjs,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}' 'test/**/*.{ts,tsx}' '*.{json,mjs,md}'",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "expo": "~57.0.24",
    "expo-camera": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "openai": "^7.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.9",
    "@types/react": "^19.1.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.8",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "private": true
}
