# OpenRouter or OpenAI compatible API Key
EXPO_PUBLIC_OPENROUTER_API_KEY=

# Default LLM model identifier (OpenRouter free model or OpenAI model)
EXPO_PUBLIC_LLM_MODEL=inclusionai/ling-3.0-flash-vl:free

# Default OpenAI-compatible Base URL
EXPO_PUBLIC_LLM_BASE_URL=https://openrouter.ai/api/v1

# Sample test receipt URL for quick simulator verification
EXPO_PUBLIC_SAMPLE_RECEIPT_URL=https://raw.githubusercontent.com/denisglotov/ai-policy-account/master/test/fixtures/sample_receipt.txt
